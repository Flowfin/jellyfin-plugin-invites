<Project>
    <!--
        The version is written in build.yaml and nowhere else. That file is the packaging
        manifest a catalogue reads, so it is the copy that has to be right, and the three
        assembly properties below are read out of it at build time rather than typed a
        second time. Two numbers for one version drift, and a plugin whose assembly
        version disagrees with its manifest version is one nobody can reason about when a
        bug report names a version.

        docs/versioning.md says which of the four parts moves for a breaking change, a
        feature and a fix.
    -->
    <PropertyGroup>
        <!-- The graph is watched, not only recorded. NuGet checks the restored graph
             against the advisory database and NU1901 to NU1904 are raised to errors, so a
             known-vulnerable package fails the restore. Left as warnings they would be
             true and green, printed into a log nobody reads.
    
             This board committed a lockfile and ran no audit, which is the worse half of
             the pair: the graph was held still and nothing looked at it. Eleven boards of
             this fleet were in that state on 2026-08-18, and the twelfth is why it
             matters. jellyfin-plugin-watchlist was told by Scorecard about one high
             advisory; switching this on found a second one rated critical that Scorecard
             had never reported.
    
             Mode all rather than direct: both of those arrived under the Jellyfin
             packages and neither was referenced by a project file, so a direct-only audit
             would have found neither.
    
             Nothing is pinned here. Measured with the audit forced on from the command
             line, this board reports no advisory today; the entry is the detector, not a
             repair.
    
             Note for whoever edits this comment: an XML comment may not contain two
             hyphens in a row. A draft elsewhere in this fleet spelled out a command line
             flag, left the file malformed, and the build failed on a property defined
             twenty lines below. -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>
        <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <PluginManifestPath>$(MSBuildThisFileDirectory)build.yaml</PluginManifestPath>
        <_PluginManifestText>$([System.IO.File]::ReadAllText($(PluginManifestPath)))</_PluginManifestText>
        <_PluginVersionLine>$([System.Text.RegularExpressions.Regex]::Match($(_PluginManifestText), '(?m)^version:[^\r\n]*'))</_PluginVersionLine>
        <PluginManifestVersion>$([System.Text.RegularExpressions.Regex]::Replace($(_PluginVersionLine), '[^0-9.]', ''))</PluginManifestVersion>
    </PropertyGroup>

    <PropertyGroup>
        <Version>$(PluginManifestVersion)</Version>
        <AssemblyVersion>$(PluginManifestVersion)</AssemblyVersion>
        <FileVersion>$(PluginManifestVersion)</FileVersion>
    </PropertyGroup>

    <!--
        build.yaml also declares targetAbi, which is the oldest server this plugin claims
        to load on. The shipping build compiles against a newer package from the same
        line, so a call into a member that arrived after the floor compiles clean here and
        throws on the oldest server the manifest invites somebody to install on. The floor
        version is derived from targetAbi rather than typed a second time: raising the
        claim in build.yaml is what moves the version the floor build compiles against, so
        the two cannot disagree.

        A NuGet package version for the server line is three parts and targetAbi is four,
        so 10.11.0.0 selects 10.11.0. The three part run is matched inside the line rather
        than stripped out of it, because stripping every non-digit from the whole line
        concatenates anything else on it into the number instead of refusing.
    -->
    <PropertyGroup>
        <_PluginTargetAbiLine>$([System.Text.RegularExpressions.Regex]::Match($(_PluginManifestText), '(?m)^targetAbi:[^\r\n]*'))</_PluginTargetAbiLine>
        <JellyfinAbiFloorVersion>$([System.Text.RegularExpressions.Regex]::Match($(_PluginTargetAbiLine), '[0-9]+\.[0-9]+\.[0-9]+'))</JellyfinAbiFloorVersion>
    </PropertyGroup>

    <!--
        The version of the Jellyfin packages the plugin compiles against. It is one
        property rather than a number repeated on each PackageReference, because the whole
        point of the floor build is that every reference moves together.
    -->
    <PropertyGroup>
        <JellyfinShippingVersion>10.11.11</JellyfinShippingVersion>
        <JellyfinPackageVersion Condition="'$(BuildAgainstAbiFloor)' == 'true'">$(JellyfinAbiFloorVersion)</JellyfinPackageVersion>
        <JellyfinPackageVersion Condition="'$(JellyfinPackageVersion)' == ''">$(JellyfinShippingVersion)</JellyfinPackageVersion>
    </PropertyGroup>

    <!--
        A floor restore resolves a different version of the same packages on purpose, so
        it must not touch the committed lock file, which pins the shipping line. Turning
        RestorePackagesWithLockFile off is not enough: that property decides whether a
        lock file is created, and NuGet updates one that already exists either way. The
        floor build is pointed at a throwaway lock file under obj/ instead, so the
        committed one is not the file the restore is holding.

        Measured rather than reasoned: the first version of this change turned the
        property off, and the leg's own read-back step caught the committed lock file
        rewritten on a clean checkout.
    -->
    <PropertyGroup Condition="'$(BuildAgainstAbiFloor)' == 'true'">
        <NuGetLockFilePath>$(MSBuildProjectDirectory)/obj/abi-floor.packages.lock.json</NuGetLockFilePath>
    </PropertyGroup>

    <!--
        Deterministic is on by default and is stated here so a change that turns it off
        has to say so. ContinuousIntegrationBuild replaces the absolute paths of the
        machine that built with relative ones, which is what stops two runners producing
        two different files from one commit.
    -->
    <PropertyGroup>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!--
        Without this, a build.yaml whose version key is missing, misspelled or not four
        parts leaves PluginManifestVersion empty, and the build quietly stamps the SDK
        default of 1.0.0.0 into the assembly while the manifest says something else. That
        is the exact drift this file exists to prevent, so it is refused rather than
        allowed through.
    -->
    <Target Name="RefuseUnreadablePluginVersion" BeforeTargets="BeforeBuild">
        <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(PluginManifestVersion)', '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'))"
               Text="No four part version could be read from $(PluginManifestPath). What was read was '$(PluginManifestVersion)'. The version lives in that file and the assembly version, file version and package version are all derived from it." />
    </Target>

    <!--
        A floor build that could not read targetAbi would leave the package version empty
        and resolve whatever NuGet felt like, which is a floor build that proves nothing
        while reporting green. It is refused instead, with the file named.
    -->
    <Target Name="RefuseUnreadableAbiFloor" BeforeTargets="BeforeBuild" Condition="'$(BuildAgainstAbiFloor)' == 'true'">
        <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(JellyfinAbiFloorVersion)', '^[0-9]+\.[0-9]+\.[0-9]+$'))"
               Text="No three part floor version could be derived from the targetAbi in $(PluginManifestPath). The line read was '$(_PluginTargetAbiLine)'. The oldest server this plugin claims to load on lives in that file and the floor build compiles against it." />
    </Target>
</Project>
