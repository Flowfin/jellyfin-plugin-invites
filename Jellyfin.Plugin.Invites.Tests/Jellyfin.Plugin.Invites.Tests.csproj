<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Invites.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The plugin is compiled for the server's framework, which is not the
         newest one a contributor's machine necessarily has a runtime for. Let
         the test host roll forward so the suite runs on a machine carrying only
         a later runtime, rather than requiring an installer to be run. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The coverage collector. It is a build-time package rather than a
         dependency of anything that ships: the plugin's runtime dependency set
         stays empty, which is #35's rule. What the numbers are and why each one
         is what it is lives in docs/coverage-floors.md. -->
    <PackageReference Include="coverlet.msbuild" Version="6.0.2" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.Invites\Jellyfin.Plugin.Invites.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One committed document per shape the store has ever declared, which is
         #105. They are read rather than generated: a fixture the suite writes
         out of the current writer moves whenever the writer does, and a
         migration fixture whose bytes follow the code it is meant to catch
         proves nothing. Copied beside the test host because a test may not read
         the source tree it happens to have been built from. -->
    <Content Include="StoreShapes\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin excludes the runtime assets of these packages because the
         server supplies them at load time. Nothing supplies them to a test
         host, so the suite carries them itself. The versions must stay equal to
         the ones the plugin compiles against, in
         Jellyfin.Plugin.Invites/Jellyfin.Plugin.Invites.csproj: a lower one
         here would run the plugin against an assembly it was not built for. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
  </ItemGroup>

</Project>
